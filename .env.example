# Supabase, ap-south-1 (Mumbai), via Supavisor in TRANSACTION mode.
# Statement mode silently drops `SET LOCAL app.tenant_id`, which breaks tenant
# isolation without anything visibly failing. Verify this before Stage 2.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

JWT_SECRET="change-me-in-production"
PORT=3001
NODE_ENV=development

# Stage 6: on Publish, the API asks the Next.js site to revalidate that tenant's
# cached pages so the change goes live at once. Unset = a logged no-op (the site
# still refreshes on its time-based ISR window). Point it at the web app's
# revalidate route; the E2E Stage 6 gate needs this set.
WEB_REVALIDATE_URL="http://localhost:3000/api/revalidate"
# WEB_REVALIDATE_SECRET="a-shared-secret"
