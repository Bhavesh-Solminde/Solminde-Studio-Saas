# Supabase, ap-south-1 (Mumbai), via Supavisor in TRANSACTION mode.
# Statement mode silently drops `SET LOCAL app.tenant_id`, which breaks tenant
# isolation without anything visibly failing. Verify this before Stage 2.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://USER:PASSWORD@HOST:5432/postgres"

PORT=3001
NODE_ENV=development
