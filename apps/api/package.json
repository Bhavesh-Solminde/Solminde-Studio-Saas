{
  "name": "@salon/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start:dev": "node scripts/free-port.mjs && nest start --watch",
    "dev": "pnpm start:dev",
    "start": "node dist/main.js",
    "build": "nest build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "rls:apply": "node scripts/apply-rls.mjs",
    "db:reset": "prisma migrate reset --force && node scripts/apply-rls.mjs",
    "db:seed": "tsx prisma/seed.ts",
    "verify:isolation": "node scripts/verify-isolation.mjs",
    "sql:apply": "node scripts/apply-sql.mjs prisma/sql/auth-functions.sql",
    "create-app-role": "node scripts/create-app-role.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.28",
    "@nestjs/core": "^11.1.28",
    "@nestjs/platform-express": "^11.1.28",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "@salon/shared": "workspace:*",
    "dotenv": "^17.4.2",
    "jose": "^6.2.7",
    "pg": "^8.22.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/schematics": "^11.1.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  },
  "type": "module",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
