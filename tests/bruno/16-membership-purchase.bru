meta {
  name: Membership Purchase
  type: http
  seq: 16
}

post {
  url: {{baseUrl}}/api/sync/push
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:pre-request {
  function uuidv4() {
    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
      const r = (Math.random() * 16) | 0;
      const v = c === "x" ? r : (r & 0x3) | 0x8;
      return v.toString(16);
    });
  }
  bru.setEnvVar("membershipOpId", uuidv4());
}

body:json {
  {
    "ops": [
      {
        "opId": "{{membershipOpId}}",
        "tenantId": "{{tenantId}}",
        "terminalId": "00000000-0000-4000-8000-0000000000b0",
        "localSeq": 1,
        "type": "membership.purchase",
        "payload": {
          "customerId": "{{customerId}}",
          "membershipId": "ffffffff-0000-4000-8000-000000000001"
        },
        "status": "pending",
        "attempts": 0,
        "createdAt": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
}

tests {
  test("membership purchase credits the wallet ledger", function () {
    expect(res.body.outcomes[0].status).to.equal("acked");
    expect(res.body.outcomes[0].result.walletCredit).to.equal(600000);
  });
}

docs {
  A membership's only balance effect modelled here is its wallet credit — one
  positive entry on the wallet ledger, so the customer's balance stays
  SUM(delta).
}
