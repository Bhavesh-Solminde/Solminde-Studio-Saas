meta {
  name: WhatsApp Send
  type: http
  seq: 23
}

post {
  url: {{baseUrl}}/api/sync/push
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{accessToken}}
}

script:pre-request {
  function uuidv4() {
    return "xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx".replace(/[xy]/g, function (c) {
      const r = (Math.random() * 16) | 0;
      const v = c === "x" ? r : (r & 0x3) | 0x8;
      return v.toString(16);
    });
  }
  bru.setEnvVar("waOpId", uuidv4());
}

body:json {
  {
    "ops": [
      {
        "opId": "{{waOpId}}",
        "tenantId": "{{tenantId}}",
        "terminalId": "00000000-0000-4000-8000-0000000000b0",
        "localSeq": 1,
        "type": "whatsapp.send",
        "payload": { "toPhone": "9812345678", "template": "bill_pdf" },
        "status": "pending",
        "attempts": 0,
        "createdAt": 1
      }
    ]
  }
}

assert {
  res.status: eq 201
}

tests {
  test("a POS-triggered WhatsApp send dispatches via the provider", function () {
    expect(res.body.outcomes[0].status).to.equal("acked");
    expect(res.body.outcomes[0].result.status).to.equal("sent");
  });
}

docs {
  WhatsApp rides the same outbox as every other write, so the front desk can
  trigger a send offline and it fires on reconnect. The provider is stubbed in
  development; the queue-then-dispatch path is real.
}
